# ==============================================================================
# MANDATE: Environment Configuration Template
# ==============================================================================

# Server & Environment Configuration
# APP_ENV: 'demo' (offline demo), 'dev' (local sandbox), or 'prod' (production)
APP_ENV=demo
HOST=0.0.0.0
PORT=8000
DEBUG=true
FRONTEND_ORIGIN=http://localhost:3000

# Security & Cryptography
# In 'dev' or 'prod', MANDATE_SIGNING_KEY must NOT be the default placeholder and must be >= 32 bytes:
# Generate with: openssl rand -hex 32
MANDATE_SIGNING_KEY=mandate_super_secure_secret_signing_key_32_bytes_min!

# Database Configuration
# Defaults to local SQLite if left empty or set to sqlite:///./mandate.db
# For production (PostgreSQL / Supabase / Neon):
# DATABASE_URL=postgresql+psycopg://user:password@ep-sample.aws.neon.tech/mandate?sslmode=require
DATABASE_URL=sqlite:///./mandate.db

# PayPal Sandbox Credentials
# Get these from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here
# If true or credentials missing, PayPal client runs in realistic simulated sandbox mode
PAYPAL_SIMULATION_MODE=false

# LLM Configuration (Risk Scorer & Arbiter)
# Supported providers: gemini, openai, anthropic, mock
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
# When true, runs on reproducible high-fidelity fixtures without external network calls
DEMO_REPLAY_MODE=false
