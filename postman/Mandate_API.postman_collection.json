    {
      "name": "5. Audit Trail & Verification",
      "item": [
        {
          "name": "Get Audit Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/audit?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["audit"],
              "query": [
                {"key": "limit", "value": "50"},
                {"key": "offset", "value": "0"}
              ]
